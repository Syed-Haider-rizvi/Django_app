<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <add key="WSGI_HANDLER"
         value="your_django_project.wsgi.application" />

    <add key="PYTHONPATH"
         value="C:\inetpub\wwwroot\Django_app" />

    <add key="DJANGO_SETTINGS_MODULE"
         value="your_django_project.settings" />

    <add key="WSGI_LOG"
         value="C:\inetpub\wwwroot\Django_app\logs\django.log" />
  </appSettings>

  <system.webServer>

    <handlers>
      <remove name="Python FastCGI" />

      <add name="Python FastCGI"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\inetpub\wwwroot\Django_app\.venv\Scripts\python.exe|C:\inetpub\wwwroot\Django_app\.venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <httpErrors errorMode="Detailed" />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".venv" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
